# Copy to agent/.env and fill in. agent/.env is git-ignored; never commit it.

# Gemini (default provider)
GEMINI_API_KEY=

# Optional: any OpenAI-compatible endpoint (e.g. local Ollama, OpenRouter) - see DECISIONS.md D15
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=ollama

# Target app
TARGET_URL=http://localhost:5173
API_URL=http://localhost:8000

# Local only: enables database resets between assertions
DEMOBANK_DATABASE_URL=postgresql://demobank:demobank_local@localhost:5432/demobank
